NMOS_CONTROLLER__REGISTRY__NAME=CS-Lab
NMOS_CONTROLLER__REGISTRY__BASEURL=http://192.168.170.2:8081
# Optional bootstrap defaults. Once registry settings are saved via API/DB,
# persisted values take precedence over these environment values.
# Optional single IS-05 base URL override. Use only when every routed receiver
# is controlled through one device/gateway endpoint. Leave blank or point it at
# the actual receiver device/gateway, e.g. http://192.168.170.5:8090.
NMOS_CONTROLLER__REGISTRY__CONNECTIONBASEURL=
# Optional multi-endpoint fallback list (comma-separated) for mixed estates.
# Example: http://172.16.32.72:4003,http://172.16.32.73:4003
NMOS_CONTROLLER__REGISTRY__CONNECTIONBASEURLS=
NMOS_CONTROLLER__REGISTRY__QUERYAPIVERSION=v1.3
NMOS_CONTROLLER__REGISTRY__CONNECTIONAPIVERSION=v1.1
NMOS_CONTROLLER__POSTGRES__CONNECTIONSTRING=Host=127.0.0.1;Port=5432;Database=nmos_controller;Username=nmos;Password=nmos
NMOS_CONTROLLER__HTTP__TIMEOUTSECONDS=30
NMOS_CONTROLLER__HTTP__RETRYATTEMPTS=3
NMOS_CONTROLLER__LOGGING__MINIMUMLEVEL=Information
NMOS_CONTROLLER__CORS__ALLOWEDORIGINS=*

BACKEND_BIND_IP=0.0.0.0
BACKEND_PORT=8090
FRONTEND_BIND_IP=172.16.32.58
FRONTEND_PORT=80
FRONTEND_LOCAL_PORT=8088

NMOS_REGISTRY_IMAGE=rhastie/nmos-cpp:latest
